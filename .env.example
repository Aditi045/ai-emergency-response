# ResQIntel AI — Environment Configuration Template
ENVIRONMENT=development
DEBUG=True

# Host & Networking
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / PostGIS for production; SQLite aiosqlite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./resqintel.db
# DATABASE_URL=postgresql://resqintel:resqintel_password@localhost:5432/resqintel_db

# Background Task Broker
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=resqintel-super-secure-production-jwt-secret-key-vit-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Geospatial & Provider Abstractions
MAP_PROVIDER=leaflet_osm
GEOCODING_PROVIDER=nominatim
ROUTING_PROVIDER=osrm
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=

# Multi-Agent AI Model Config
AI_PROVIDER=resqintel_multimodal_engine
GEMINI_API_KEY=

# Genuine Local Computer Vision (Ultralytics YOLO)
VISION_PROVIDER=local
VISION_MODEL_PATH=yolov8n.pt
VISION_CONFIDENCE_THRESHOLD=0.25

# Genuine Local Speech-to-Text (faster-whisper)
SPEECH_PROVIDER=local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
