# Optional Map Provider Configuration
# By default, ResQIntel AI uses standard OpenStreetMap tiles (100% free, no API key required, no watermark).
# If you wish to use CARTO basemaps, request a free key at https://carto.com/basemaps/apikey/ and set it below:
VITE_CARTO_API_KEY=
# Or custom Tile URL:
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
